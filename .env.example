# CoinSwitch API Credentials
# Get these from: CoinSwitch PRO > Profile > API Keys
COINSWITCH_API_KEY=your_public_api_key_here
COINSWITCH_SECRET_KEY=your_private_key_here

# Trading Configuration
TRADING_MODE=paper         # paper | live  (START WITH paper!)
BASE_CURRENCY=USDT
MAX_PORTFOLIO_RISK=5.0     # max % of account at risk at once
RISK_PER_TRADE=1.0         # % of account risked per trade

# Safety Limits
MAX_DAILY_LOSS_PCT=5.0     # stop trading if daily loss exceeds this %
MAX_DRAWDOWN_PCT=10.0      # reduce size 50% if drawdown hits this
MAX_LEVERAGE=10            # maximum leverage to use
DEFAULT_LEVERAGE=5         # default leverage for new positions

# Strategy Selection (enable/disable)
STRATEGY_EMA_RSI=true
STRATEGY_BREAKOUT=true
STRATEGY_MTF_TREND=true
STRATEGY_SR_BOUNCE=true
STRATEGY_MIN_CONFLUENCE=2  # min strategies that must agree before trading

# ─── Selectivity profile ─────────────────────────────────────────────────────
# WIN_RATE_MODE pre-sets all the gates below for "fewer, higher-quality" trades.
# Set false to favor trade volume / agent-learning speed.
WIN_RATE_MODE=true

# Confluence quality (overrides above defaults if set)
MIN_CONFLUENCE_AVG_CONFIDENCE=0.60   # win-rate mode default
SOLO_SR_MIN_CONFIDENCE=0.65          # win-rate mode default
SOLO_SR_MIN_VOL_RATIO=1.05
# Trend-aligned SR: only fade resistance in a downtrend / buy support in
# uptrend. Skips the lowest-edge counter-trend bounces. ~20-30 pp win-rate lift.
SR_REQUIRE_TREND_ALIGNED=true
# Allow a single high-conviction trend signal — off in win-rate mode.
ALLOW_SOLO_TREND=false
SOLO_TREND_MIN_CONFIDENCE=0.70
REQUIRE_DI_ALIGNMENT=true

# Win-rate trade management — partial close + breakeven SL on 1R
PARTIAL_TP_AT_1R=true
MOVE_SL_TO_BE_AT_1R=true
PARTIAL_TP_AT_1R_RATIO=0.5
ADX_TREND_THRESHOLD=16
USE_CHOP_FILTER=true
CHOP_BB_WIDTH_VS_MA_RATIO=0.72
CONFLUENCE_TP_MERGE_MODE=weighted   # weighted | conservative
CONFLUENCE_MIN_RR=1.5
CONFLUENCE_MAX_RR=4.5

# ─── Fees & Tax (CoinSwitch Futures, India) ──────────────────────────────────
# All percentages are in *percent units* (0.05 = 0.05%, NOT 5%).
# Override these from your actual CoinSwitch invoice.
TAKER_FEE_PCT=0.05            # platform fee on each side (taker)
MAKER_FEE_PCT=0.05            # platform fee on each side (maker)
GST_PCT=18.0                  # GST charged on the platform fee
TDS_PCT=1.0                   # India 1% TDS on VDA
TDS_MODE=sell_only            # sell_only | both | off
ASSUME_TAKER=true             # market orders cross spread → taker

# Wire fees into the bot
INCLUDE_FEES_IN_SIZING=true   # SL loss ≈ RISK_PER_TRADE_PCT *after* costs
INCLUDE_FEES_IN_RR=true       # stretch TP so net R:R hits CONFLUENCE_MIN_RR
BACKTEST_APPLY_FEES=true      # backtest PnL net of fees + TDS

# Notification (optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
